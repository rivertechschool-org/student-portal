(
    name: "Fright Space - menu",
    seed: 1,
    // the play area's origin is the camera's look point: at (0, 0) the game's frame is the level's own
    camera: ( eye: Some((0.0, -10.0)), target: Some((0.0, 0.0)) ),
    interior: Some((ambient: (0.0, 0.0, 0.0), background: (0.0, 0.0, 0.0))),
    // Unity draws single-sided materials from the front only: the corridor's near walls are seen through
    // Unity 2017 here had no auto exposure and no filmic curve: a fixed exposure, matched to the 2019
    // frame (docs/PORT_SPEC.md "Light"), and the most neutral tone curve
    look: ( cull_back_faces: true, skyvis: false, exposure: Some(6.0), fx: ( auto_exposure: false, tonemapper: Neutral ) ),
    size: 160.0,
    terrain: ( height: Some(0.0), plain: Some(1.0) ),
    erosion: ( strength: Some(0.0) ),
    cover: ( props: Some(0), trees: Some(0), grass_spacing: Some(64.0) ),
    climate: ( lakes: Some(0.0), weather: None, hour: Some(0.0) ),
    imports: [
    ],
    placed: [
    ],
)
