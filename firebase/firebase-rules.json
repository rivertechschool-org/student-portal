{
  "rules": {
    "arcade": {

      "players": {
        "_comment": "Firebase rules cascade DOWN, never up. A .read on $supabase_uid grants reading ONE player; the friend search queries this parent node, which needs its own .read or the whole query is refused.",
        ".read": true,
        ".indexOn": "display_name",
        "$supabase_uid": {
          ".read": true,
          ".write": "auth != null && auth.uid == $supabase_uid"
        }
      },

      "friends": {
        "$supabase_uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid == $supabase_uid",
          "list": {
            "$friend_id": {
              ".write": "auth != null && (auth.uid == $supabase_uid || auth.uid == $friend_id)"
            }
          },
          "requests": {
            "incoming": {
              "$from_id": {
                ".write": "auth != null && auth.uid == $from_id"
              }
            },
            "outgoing": {
              "$to_id": {
                ".write": "auth != null && auth.uid == $supabase_uid"
              }
            }
          },
          "invites": {
            "$invite_id": {
              ".write": "auth != null"
            }
          }
        }
      },

      "games": {
        "$game_id": {
          "collections": {
            "$supabase_uid": {
              ".read": "auth != null",
              ".write": "auth != null && auth.uid == $supabase_uid"
            }
          },
          "decks": {
            "$supabase_uid": {
              ".read": true,
              ".write": "auth != null && auth.uid == $supabase_uid"
            }
          },
          "stats": {
            "$supabase_uid": {
              ".read": true,
              ".write": "auth != null && auth.uid == $supabase_uid"
            }
          }
        }
      },

      "matchmaking": {
        "$game_id": {
          "queue": {
            ".read": true,
            ".write": "auth != null"
          },
          "lobbies": {
            "_comment": "Joining by code queries THIS node for a matching join_code. Without a .read here that query is denied outright - which is what made Join Lobby report that the client has no permission, while creating a lobby worked fine.",
            ".read": true,
            ".indexOn": ["join_code", "status"],
            "$lobby_id": {
              ".read": true,
              ".write": "auth != null"
            }
          }
        }
      },

      "matches": {
        "$game_id": {
          "_comment": "Listing active matches queries this node, so it needs its own .read for the same reason as lobbies.",
          ".read": true,
          ".indexOn": "status",
          "$match_id": {
            ".read": true,
            ".write": "auth != null && (data.child('players/1/supabase_user_id').val() == auth.uid || data.child('players/2/supabase_user_id').val() == auth.uid || !data.exists())"
          }
        }
      },

      "spectating": {
        "$match_id": {
          ".read": true,
          "spectators": {
            "$supabase_uid": {
              ".read": true,
              ".write": "auth != null && auth.uid == $supabase_uid"
            }
          }
        }
      },

      "leaderboards": {
        "$game_id": {
          ".read": true,
          ".write": false
        }
      }
    }
  }
}
